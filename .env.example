# e-Abhilekh environment — copy to .env and fill in. ALL VALUES BELOW ARE FAKE.
# Generate real secrets with:  python scripts/gen_keys.py

# dev | prod — dev-only demo endpoints (POST /api/v1/dev/...) return 404 unless dev
EABHILEKH_ENV=dev

# 32-byte master key for envelope encryption, hex-encoded (64 hex chars). REQUIRED.
EABHILEKH_MASTER_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# HS256 signing secret for JWTs. REQUIRED in production.
EABHILEKH_JWT_SECRET=change-me-to-a-long-random-string-in-production

# PostgreSQL (compose default matches infra/compose.yaml)
DATABASE_URL=postgresql+psycopg://eabhilekh:eabhilekh@postgres:5432/eabhilekh

# --- Object storage: MinIO (S3-compatible). Leave MINIO_ENDPOINT empty to use
# --- the local-filesystem fallback instead (dev/tests).
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=e-abhilekh
MINIO_SECURE=false

# Local fallback storage root (used when MINIO_ENDPOINT is unset). Plaintext is
# NEVER written here — only ciphertext blobs.
EABHILEKH_LOCAL_STORAGE=/srv/data/storage
EABHILEKH_STAGING_DIR=/srv/data/staging

# --- ClamAV (optional). Unset => AV step records {"av":"skipped"} and continues.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Frontend build arg (used by infra/compose.yaml web service)
VITE_API_URL=http://localhost:8000
